{
  "name": "intentlang",
  "version": "0.8.0-alpha.0",
  "private": true,
  "type": "module",
  "bin": {
    "intentlang": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:browser": "tsx --test test/visual.browser.ts test/web.browser.ts test/last-signal.browser.ts test/gallery.browser.ts test/studio.browser.ts",
    "sample:visual": "tsx src/cli.ts visual examples/hello-world.visual.intent",
    "sample:check": "tsx src/cli.ts check examples/todo.intent",
    "sample:format": "tsx src/cli.ts format examples/todo.intent",
    "sample:compile": "tsx src/cli.ts compile examples/todo.intent --output examples/todo.ir.json --write --force",
    "sample:generate": "tsx src/cli.ts generate examples/todo.intent --output examples/todo-app --write --force --allow-security-downgrade",
    "sample:serve": "node examples/todo-app/app.mjs",
    "sample:studio": "tsx src/cli.ts studio examples/todo.intent --no-open",
    "example:issue-tracker:check": "tsx src/cli.ts check examples/issue-tracker.intent"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "24.13.2",
    "playwright": "1.63.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@vscode/web-custom-data": "0.6.3",
    "css-tree": "3.2.1",
    "parse5": "8.0.1"
  }
}
